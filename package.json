{
  "name": "guitarlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.5"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/lib/**/*.ts\" \"src/app.d.ts\" \"*.{js,json,ts}\" \"wrangler.jsonc\" \"scripts/validate-design-tokens.mjs\" \"scripts/finalize-db-migration.mjs\" \"scripts/test-local-db.mjs\" \"scripts/browser-acceptance.mjs\" \"scripts/curriculum-browser-acceptance.mjs\"",
    "format:check": "prettier --check \"src/lib/**/*.ts\" \"src/app.d.ts\" \"*.{js,json,ts}\" \"wrangler.jsonc\" \"scripts/validate-design-tokens.mjs\" \"scripts/finalize-db-migration.mjs\" \"scripts/test-local-db.mjs\" \"scripts/browser-acceptance.mjs\" \"scripts/curriculum-browser-acceptance.mjs\"",
    "test": "vitest",
    "test:run": "vitest run",
    "curriculum:validate": "node scripts/validate-curriculum.mjs",
    "cf-typegen": "wrangler types",
    "design:validate": "node scripts/validate-design-tokens.mjs",
    "db:generate": "drizzle-kit generate",
    "db:finalize": "node scripts/finalize-db-migration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply guitarlab-local --local",
    "db:test:local": "node scripts/test-local-db.mjs",
    "db:setup:local": "npm run db:generate && npm run db:finalize && npm run db:migrate:local && npm run db:test:local",
    "test:browser": "node scripts/browser-acceptance.mjs",
    "test:curriculum-browser": "node scripts/curriculum-browser-acceptance.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "zod": "^4.0.0",
    "drizzle-orm": "^0.45.4"
  }
}
