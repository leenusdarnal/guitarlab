{
  "name": "guitarlab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && vite build",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/lib/**/*.ts\" \"src/app.d.ts\" \"*.{js,json,jsonc,ts}\" \"scripts/validate-design-tokens.mjs\"",
    "format:check": "prettier --check \"src/lib/**/*.ts\" \"src/app.d.ts\" \"*.{js,json,jsonc,ts}\" \"scripts/validate-design-tokens.mjs\"",
    "test": "vitest",
    "test:run": "vitest run",
    "curriculum:validate": "node scripts/validate-curriculum.mjs",
    "cf-typegen": "wrangler types",
    "design:validate": "node scripts/validate-design-tokens.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0",
    "@eslint/js": "^10.0.1"
  },
  "dependencies": {
    "zod": "^4.0.0"
  }
}
