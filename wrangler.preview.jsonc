{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guitarlab-preview",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BETTER_AUTH_URL": "https://guitarlab-preview.leenusdarnal.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "guitarlab-auth-preview",
      "database_id": "2abf9a07-620a-4c24-8d12-f75b34b31d21",
      "migrations_dir": "drizzle/auth-migrations"
    }
  ]
}
